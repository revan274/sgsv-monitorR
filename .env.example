# Frontend. En despliegue unificado puede omitirse para usar la misma URL.
VITE_API_URL=http://localhost:4000

# Backend cloud.
PORT=4000
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=change-this-long-random-secret
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173

# Usuario inicial. Solo se crea cuando la tabla users esta vacia.
ADMIN_EMAIL=admin@sgsv.local
ADMIN_PASSWORD=ChangeMe.SGSV.123

# Storage cloud para evidencias. Recomendado: bucket publico "media".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media
MEDIA_MAX_BYTES=12582912
